{
  "name": "scheme-saathi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @saathi/web",
    "build": "npm run build -w @saathi/web",
    "start": "npm run start -w @saathi/web",
    "lint": "npm run lint -w @saathi/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/web",
    "db:generate": "npm run generate -w @saathi/db",
    "db:push": "npm run push -w @saathi/db",
    "db:studio": "npm run studio -w @saathi/db",
    "seed": "npm run seed -w @saathi/db"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
