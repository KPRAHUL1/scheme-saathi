# Copy this file to `.env` at the repo root. One file serves the web app,
# the Prisma CLI and the seed script. Never commit `.env`.

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard -> your project -> Connect -> turn "Connection pooling" ON.
# The pooled host contains "-pooler". Use that one: every serverless function
# invocation opens a connection, and a direct connection runs out fast.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- AI -----------------------------------------------------------------------
# "gemini" or "bedrock" (see apps/web/lib/llm.ts). Voice recordings always use
# Gemini, because Claude on Bedrock does not accept audio.
LLM_PROVIDER="gemini"

# Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=""

# Bedrock (Claude): uses your AWS credentials, no Anthropic API key needed.
# The AWS account must be allowed to invoke the model in the Bedrock console.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional. Defaults to anthropic.claude-opus-5.
BEDROCK_MODEL=""
